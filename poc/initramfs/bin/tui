#!/bin/busybox sh
# ============================================================
# tui - POC phase 4 (v4: pure-ASCII, fully centered, per-row layout)
# v4 fixes (20:46 live test):
#   - ALL-ASCII box chars (+ - | > *) : UTF-8 borders garbled under
#     C locale and rescue console. No unicode anywhere at runtime.
#   - selected row no longer bleeds through the right column:
#     each row is composed as one string |left|right| before print
#   - panel height adapts to snapshot count; fully centered (h+v)
#   - info.json OK/MISSING diagnostic line in detail pane
# v2/v3 fixes retained: stty raw/-echo + sane on exit, per-row compose
# ============================================================
set -u
export PATH=/bin
export TZ=CST-8
R=/mnt/rootfs
SNAP_DIR=$R/timeshift-btrfs/snapshots
BTRFS=/bin/btrfs

cleanup_tty() { stty sane 2>/dev/null; }
trap cleanup_tty EXIT INT TERM

[ -d "$SNAP_DIR" ] || { echo "no snapshots dir (reboot into rescue)"; exit 1; }

ROWS=24; COLS=80
sz=$(stty size 2>/dev/null)
[ -n "${sz:-}" ] && { ROWS=${sz% *}; COLS=${sz#* }; }
stty raw -echo 2>/dev/null

# ---- geometry: panel width (height needs CNT, computed after enumeration) ----
PW=$((COLS - 4)); [ "$PW" -gt 96 ] && PW=96
PX=$(( (COLS - PW) / 2 + 1 ))
LW=48
RW=$((PW - LW - 2))

pad() { printf '%-*.*s' "$2" "$2" "$1"; }
hline() { printf '%*s' "$1" '' | tr ' ' '-'; }
prow() { printf '\033[%d;%dH|%s|%s|' "$1" "$PX" "$(pad "$2" "$LW")" "$(pad "$3" "$RW")"; }

# ---------- keys ----------
getkey() {
    KEY=""
    K=$(dd bs=1 count=1 2>/dev/null)
    case "$K" in
        "$(printf '\033')")
            K2=$(dd bs=1 count=1 2>/dev/null)
            if [ "$K2" = "[" ]; then
                K3=$(dd bs=1 count=1 2>/dev/null)
                case "$K3" in
                    A) KEY=UP ;;
                    B) KEY=DOWN ;;
                    *) KEY=OTHER ;;
                esac
            fi ;;
        "$(printf '\r')") KEY=ENTER ;;
        R|r) KEY=RECOVER ;;
        S|s) KEY=SHELL ;;
        P|p) KEY=POWEROFF ;;
        q|Q) KEY=SHELL ;;
    esac
}

getfield() {
    grep -m1 "\"$1\"" "$2" 2>/dev/null | sed 's/^[^:]*:[[:space:]]*//' | tr -d '",'
}

# ---------- snapshots ----------
NAMES=""
for d in "$SNAP_DIR"/*/; do
    [ -d "${d}@" ] || continue
    NAMES="$NAMES $(basename "$d")"
done
[ -n "$NAMES" ] || { cleanup_tty; echo "no snapshots found"; exit 1; }
CNT=0
for n in $NAMES; do CNT=$((CNT + 1)); done

IDX=$CNT
OFF=1

# ---- geometry needing CNT: content-sized panel, centered both axes ----
LR=$CNT; [ "$LR" -gt 12 ] && LR=12          # max visible list rows
PH=$((LR + 8))                               # top+hdr+blank+colhdr+LR+foot+note+bottom
[ "$PH" -ge "$ROWS" ] && { LR=$((ROWS - 9)); PH=$((LR + 8)); }
PY=$(( (ROWS - PH) / 2 + 1 ))
CAP=$LR

tag_of() {
    f=$(getfield tags "$SNAP_DIR/$1/info.json")
    case "$f" in
        ondemand|daily|weekly|monthly|boot) echo "$f" ;;
        "") echo "-" ;;
        *) echo "$f" ;;
    esac
}
has_esp() { ls "$SNAP_DIR/$1/@/.recovery/"esp-*.tar.gz >/dev/null 2>&1; }

# ---------- draw ----------
draw() {
    SEL_NAME=$(eval echo \${$IDX})
    printf '\033[H\033[2J\033[?25l'

    printf '\033[%d;%dH+%s+' "$PY" "$PX" "$(hline $((PW - 2)))"
    H=" BTRFS RESCUE - /dev/nvme0n1p2 - ${CNT} snapshots - restore mode"
    printf '\033[%d;%dH|\033[7m%s\033[0m|' "$((PY + 1))" "$PX" "$(pad "$H" $((PW - 2)))"
    prow "$((PY + 2))" "" ""
    prow "$((PY + 3))" " SNAPSHOT                       TAG        ESP" " DETAIL"

    INFO="$SNAP_DIR/$SEL_NAME/info.json"
    INFO_OK="-"
    [ -f "$INFO" ] && INFO_OK="OK"
    C=$(getfield comments "$INFO"); [ -n "$C" ] || C="-"
    L=$(getfield live "$INFO"); [ -n "$L" ] || L="-"
    SV=$($BTRFS subvolume list $R 2>/dev/null | awk -v s="$SEL_NAME" '$0 ~ "path timeshift-btrfs/snapshots/"s"/@$" {print $2}')
    if has_esp "$SEL_NAME"; then E="* tar.gz"; else E="-"; fi

    k=0
    dr=0
    for n in $NAMES; do
        k=$((k + 1))
        [ "$k" -lt "$OFF" ] && continue
        [ "$k" -ge $((OFF + CAP)) ] && break
        r=$((PY + 4 + dr))
        T=$(tag_of "$n")
        if has_esp "$n"; then EE="tar.gz"; else EE="-"; fi
        LEFT="  $n"
        [ "$k" = "$IDX" ] && LEFT="> $n"
        RIGHT=""
        case $dr in
            0) RIGHT=" DETAIL" ;;
            1) RIGHT=" name    $SEL_NAME" ;;
            2) RIGHT=" tag     $(tag_of "$SEL_NAME")" ;;
            3) RIGHT=" comment $(pad "$C" 18)" ;;
            4) RIGHT=" live    $L" ;;
            5) RIGHT=" subvol  ${SV:-?}" ;;
            6) RIGHT=" esp     $E" ;;
            7) RIGHT=" info.json $INFO_OK" ;;
        esac
        if [ "$k" = "$IDX" ]; then
            printf '\033[%d;%dH|\033[7m%s\033[0m|%s|' "$r" "$PX" "$(pad "$LEFT" "$LW")" "$(pad "$RIGHT" "$RW")"
        else
            prow "$r" "$LEFT" "$RIGHT"
        fi
        dr=$((dr + 1))
    done
    while [ "$dr" -lt "$CAP" ]; do
        prow "$((PY + 4 + dr))" "" ""
        dr=$((dr + 1))
    done

    F=" Up/Dn select | ENTER restore | R recover | S shell | P poweroff"
    printf '\033[%d;%dH|\033[7m%s\033[0m|' "$((PY + PH - 2))" "$PX" "$(pad "$F" $((PW - 2)))"
    printf '\033[%d;%dH|%s|' "$((PY + PH - 1))" "$PX" "$(pad " restore = @ swap + ESP writeback. @home is NEVER touched." $((PW - 2)))"
    printf '\033[%d;%dH+%s+' "$((PY + PH))" "$PX" "$(hline $((PW - 2)))"
}

confirm() {
    printf '\033[%d;%dH|\033[7m%s\033[0m|' "$((PY + PH - 2))" "$PX" \
        "$(pad " Restore $SEL_NAME ? (y/N) " $((PW - 2)))"
    K=$(dd bs=1 count=1 2>/dev/null)
    case "$K" in
        y|Y|"$(printf '\r')") return 0 ;;
        *) return 1 ;;
    esac
}

# ---------- main ----------
while :; do
    draw
    getkey
    case "$KEY" in
        UP)   [ "$IDX" -gt 1 ] && { IDX=$((IDX - 1)); [ "$IDX" -lt "$OFF" ] && OFF=$IDX; } ;;
        DOWN) [ "$IDX" -lt "$CNT" ] && { IDX=$((IDX + 1)); [ "$IDX" -ge $((OFF + CAP)) ] && OFF=$((IDX - CAP + 1)); } ;;
        ENTER)
            SEL_NAME=$(eval echo \${$IDX})
            if confirm; then
                cleanup_tty
                printf '\033[2J\033[H\033[?25h'
                exec /bin/rollback "$SEL_NAME" --yes
            fi ;;
        RECOVER)
            cleanup_tty
            printf '\033[2J\033[H\033[?25h'
            exec /bin/rollback --recover "$SEL_NAME" --yes ;;
        SHELL)
            cleanup_tty
            printf '\033[2J\033[H\033[?25h'
            echo "* shell (type 'tui' to return)"
            exec /bin/sh ;;
        POWEROFF)
            cleanup_tty
            exec /bin/busybox poweroff -f ;;
    esac
done
