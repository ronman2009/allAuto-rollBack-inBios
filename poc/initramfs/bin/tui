#!/bin/busybox sh
# ============================================================
# tui - POC phase 4 (v3: faithful design-B layout)
# 居中固定宽度面板 + 外框 + 双栏分隔 + 全宽 header/footer 条
# v2 fixes retained: stty raw/-echo, dynamic size, info.json parse
# ============================================================
set -u
export PATH=/bin
export TZ=CST-8
R=/mnt/rootfs
SNAP_DIR=$R/timeshift-btrfs/snapshots
BTRFS=/bin/btrfs

cleanup_tty() { stty sane 2>/dev/null; }
trap cleanup_tty EXIT INT TERM

[ -d "$SNAP_DIR" ] || { echo "no snapshots dir (reboot into rescue)"; exit 1; }

ROWS=24; COLS=80
sz=$(stty size 2>/dev/null)
[ -n "$sz" ] && { ROWS=${sz% *}; COLS=${sz#* }; }
stty raw -echo 2>/dev/null

# ---- panel geometry: centered, fixed width, like the mockup ----
PW=$((COLS - 4)); [ "$PW" -gt 96 ] && PW=96
PX=$(( (COLS - PW) / 2 + 1 ))
PH=$((ROWS - 2))
PY=$(( (ROWS - PH) / 2 + 1 ))
LW=52                       # left column width (inside borders)
RW=$((PW - LW - 2))         # right column width
LR=$((PH - 6))              # list rows capacity
[ "$LR" -lt 3 ] && LR=3
DXL=$((LW + 2))             # detail text offset inside panel (after left border+col)

pad() { printf '%-*.*s' "$2" "$2" "$1"; }
hline() { printf '%*s' "$1" '' | tr ' ' '─'; }

# ---------- keys ----------
getkey() {
    KEY=""
    K=$(dd bs=1 count=1 2>/dev/null)
    case "$K" in
        "$(printf '\033')")
            K2=$(dd bs=1 count=1 2>/dev/null)
            if [ "$K2" = "[" ]; then
                K3=$(dd bs=1 count=1 2>/dev/null)
                case "$K3" in
                    A) KEY=UP ;;
                    B) KEY=DOWN ;;
                    *) KEY=OTHER ;;
                esac
            fi ;;
        "$(printf '\r')") KEY=ENTER ;;
        R|r) KEY=RECOVER ;;
        S|s) KEY=SHELL ;;
        P|p) KEY=POWEROFF ;;
        q|Q) KEY=SHELL ;;
    esac
}

getfield() {
    grep -m1 "\"$1\"" "$2" 2>/dev/null | sed 's/^[^:]*:[[:space:]]*//' | tr -d '",'
}

# ---------- snapshots ----------
NAMES=""
for d in "$SNAP_DIR"/*/; do
    [ -d "${d}@" ] || continue
    NAMES="$NAMES $(basename "$d")"
done
[ -n "$NAMES" ] || { cleanup_tty; echo "no snapshots found"; exit 1; }
CNT=0
for n in $NAMES; do CNT=$((CNT + 1)); done

IDX=$CNT
OFF=1
[ "$CNT" -lt "$LR" ] && LR=$CNT
CAP=$LR

tag_of() {
    f=$(getfield tags "$SNAP_DIR/$1/info.json")
    case "$f" in
        ondemand|daily|weekly|monthly|boot) echo "$f" ;;
        "") echo "-" ;;
        *) echo "$f" ;;
    esac
}
has_esp() { ls "$SNAP_DIR/$1/@/.recovery/"esp-*.tar.gz >/dev/null 2>&1; }

# one panel row: │left(pad LW)│right(pad RW)│
prow() { # $1=row $2=left $3=right
    printf '\033[%d;%dH│%s│%s│' "$1" "$PX" "$(pad "$2" "$LW")" "$(pad "$3" "$RW")"
}

# ---------- draw ----------
draw() {
    SEL_NAME=$(eval echo \${$IDX})
    printf '\033[H\033[2J\033[?25l'

    # top border
    printf '\033[%d;%dH┌%s┐' "$PY" "$PX" "$(hline $((PW - 2)))"
    # header bar (inverse, full panel width)
    H=" ■ BTRFS RESCUE · /dev/nvme0n1p2 · ${CNT} snapshots · restore mode"
    printf '\033[%d;%dH│\033[7m%s\033[0m│' "$((PY + 1))" "$PX" "$(pad "$H" $((PW - 2)))"
    # blank row
    prow "$((PY + 2))" "" ""
    # column header row
    prow "$((PY + 3))" " SNAPSHOT                       TAG        ESP" " DETAIL"

    # list + detail rows
    SV=$($BTRFS subvolume list $R 2>/dev/null | awk -v s="$SEL_NAME" '$0 ~ "path timeshift-btrfs/snapshots/"s"/@$" {print $2}')
    INFO="$SNAP_DIR/$SEL_NAME/info.json"
    C=$(getfield comments "$INFO"); [ -n "$C" ] || C="-"
    L=$(getfield live "$INFO"); [ -n "$L" ] || L="-"
    if has_esp "$SEL_NAME"; then E="✔ tar.gz"; else E="-"; fi

    k=0
    dr=0
    for n in $NAMES; do
        k=$((k + 1))
        [ "$k" -lt "$OFF" ] && continue
        [ "$k" -ge $((OFF + CAP)) ] && break
        r=$((PY + 4 + dr))
        T=$(tag_of "$n")
        if has_esp "$n"; then EE="tar.gz"; else EE="-"; fi
        LEFT=" "
        [ "$k" = "$IDX" ] && LEFT="▸"
        LEFT="$LEFT $n"
        if [ "$k" = "$IDX" ]; then
            printf '\033[%d;%dH│\033[44m\033[1m%s│%s\033[0m│' "$r" "$PX" \
                "$(pad "$LEFT" $LW)" "$(pad " " "$RW")"
        else
            prow "$r" "$LEFT" ""
        fi
        # detail column rows (right side, aligned with list rows)
        case $dr in
            0) printf '\033[%d;%dH\033[96m DETAIL\033[0m' "$r" $((PX + DXL)) ;;
            1) printf '\033[%d;%dH name    %s' "$r" $((PX + DXL)) "$SEL_NAME" ;;
            2) printf '\033[%d;%dH tag     %s' "$r" $((PX + DXL)) "$(tag_of "$SEL_NAME")" ;;
            3) printf '\033[%d;%dH comment %.20s' "$r" $((PX + DXL)) "$C" ;;
            4) printf '\033[%d;%dH live    %s' "$r" $((PX + DXL)) "$L" ;;
            5) printf '\033[%d;%dH subvol  %s' "$r" $((PX + DXL)) "${SV:-?}" ;;
            6) printf '\033[%d;%dH esp     %s' "$r" $((PX + DXL)) "$E" ;;
        esac
        dr=$((dr + 1))
    done
    # fill remaining rows below list
    while [ "$dr" -lt "$CAP" ]; do
        prow "$((PY + 4 + dr))" "" ""
        dr=$((dr + 1))
    done

    # footer hotkey bar (inverse, full width) + note row + bottom border
    F=" ↑↓ select    ENTER restore    R recover    S shell    P poweroff"
    printf '\033[%d;%dH│\033[7m%s\033[0m│' "$((PY + PH - 2))" "$PX" "$(pad "$F" $((PW - 2)))"
    printf '\033[%d;%dH│%s│' "$((PY + PH - 1))" "$PX" "$(pad " restore = @ swap + ESP writeback. @home is NEVER touched." $((PW - 2)))"
    printf '\033[%d;%dH└%s┘' "$((PY + PH))" "$PX" "$(hline $((PW - 2)))"
}

confirm() {
    printf '\033[%d;%dH\033[7m Restore %s ? (y/N) \033[0m' \
        "$((PY + PH - 2))" "$PX" "$SEL_NAME"
    K=$(dd bs=1 count=1 2>/dev/null)
    case "$K" in
        y|Y|"$(printf '\r')") return 0 ;;
        *) return 1 ;;
    esac
}

# ---------- main ----------
while :; do
    draw
    getkey
    case "$KEY" in
        UP)   [ "$IDX" -gt 1 ] && { IDX=$((IDX - 1)); [ "$IDX" -lt "$OFF" ] && OFF=$IDX; } ;;
        DOWN) [ "$IDX" -lt "$CNT" ] && { IDX=$((IDX + 1)); [ "$IDX" -ge $((OFF + CAP)) ] && OFF=$((IDX - CAP + 1)); } ;;
        ENTER)
            SEL_NAME=$(eval echo \${$IDX})
            if confirm; then
                cleanup_tty
                printf '\033[2J\033[H\033[?25h'
                exec /bin/rollback "$SEL_NAME" --yes
            fi ;;
        RECOVER)
            cleanup_tty
            printf '\033[2J\033[H\033[?25h'
            exec /bin/rollback --recover "$SEL_NAME" --yes ;;
        SHELL)
            cleanup_tty
            printf '\033[2J\033[H\033[?25h'
            echo "* shell (type 'tui' to return)"
            exec /bin/sh ;;
        POWEROFF)
            cleanup_tty
            exec /bin/busybox poweroff -f ;;
    esac
done
